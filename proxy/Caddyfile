# proxy/Caddyfile -- proxy public : TLS interne + WAF Coraza (OWASP CRS).
# Seul point expose ; Moodle reste sur des reseaux internes (aucun egress).
{
	order coraza_waf first
}

{$PROXY_HOST:localhost} {
	# Site nomme -> Caddy emet un cert interne pour cet hote (SNI). Demo : acces
	# par tunnel SSH sur https://localhost. Production : lms.etablissement.cm + PKI.
	# Repli hors-ligne : autorite interne de Caddy (cert auto-signe).
	tls internal

	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			# --- Calibration Moodle : 2 faux positifs observes (cf. docs/RUNBOOK-SOUTENANCE.md) ---
			# 920420 (type de contenu) : certains appels AJAX de Moodle arrivent en text/plain.
			# Desactivee UNIQUEMENT pour /lib/ajax/service.php ; partout ailleurs elle reste active.
			# (Doit preceder l'inclusion du CRS pour que le ctl: s'applique.)
			SecRule REQUEST_URI "@beginsWith /lib/ajax/service.php" "id:1000010,phase:1,pass,nolog,ctl:ruleRemoveById=920420"
			Include @owasp_crs/*.conf
			# 932260 (commande Unix) : "groupmod" matche le NOM des champs Moodle groupmode et
			# groupmodeforce (formulaires d'activite et de cours). On retire seulement la cible
			# ARGS_NAMES pour ces noms : les VALEURS des parametres restent inspectees.
			SecRuleUpdateTargetById 932260 "!ARGS_NAMES:/^groupmode/"
			# 933160 (appel de fonction PHP a haut risque) : une question legitime sur Python contenant
			# os.system/subprocess/eval declenche cette regle generique PHP, sans rapport avec du code
			# reellement execute. Exclue UNIQUEMENT pour le service web du tuteur IA
			# (aiplacement_tuteur_generate_text), PAS pour aiplacement_editor qui utilise le meme nom de
			# parametre "prompttext" -- son exposition WAF reste inchangee. Seule la cible
			# ARGS:json.0.args.prompttext est retiree de la regle 933160 (confirme via les logs Coraza,
			# le corps JSON du batch AJAX Moodle donne ce chemin ARGS) ; le reste de la requete (et toute
			# autre regle) continue d'etre inspecte normalement.
			SecRule ARGS_GET:info "@streq aiplacement_tuteur_generate_text" "id:1000012,phase:1,pass,nolog,ctl:ruleRemoveTargetById=933160;ARGS:json.0.args.prompttext"
			SecRuleEngine On
			# Inspection des REPONSES desactivee : la sortie du tuteur (code/maths
			# pedagogiques) ne doit pas etre scannee/bufferisee par le CRS ; sa
			# surete est deja assuree par le niveau N4 (FORMAT_PLAIN cote plugin).
			SecResponseBodyAccess Off
		`
	}

	reverse_proxy moodle:8080
}
